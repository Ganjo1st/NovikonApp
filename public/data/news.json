430\u043d\u0442 \u043e\u0442\u0441\u0442\u0443\u043f\u0438\u0442 \u2013 \u0438 \u043d\u0438 \u043e\u0434\u0438\u043d \u0438\u0433\u0440\u043e\u043a \u043d\u0435 \u0437\u0430\u043c\u0435\u043d\u0438\u0442 \u0435\u0433\u043e \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e? \u0422\u0440\u0438 \u0441\u043e\u0431\u044b\u0442\u0438\u044f, \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u0435\u0434\u0448\u0438\u0435 \u0437\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 18 \u043c\u0435\u0441\u044f\u0446\u0435\u0432, \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u044d\u0442\u043e\u0442 \u0432\u043e\u043f\u0440\u043e\u0441 \u0432\u0441\u0435 \u0431\u043e\u043b\u0435\u0435 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u043c. \u041d\u0430 \u0441\u0430\u043c\u043c\u0438\u0442\u0435 \u0411\u0420\u0418\u041a\u0421 \u0432 2024 \u0433\u043e\u0434\u0443 \u0420\u043e\u0441\u0441\u0438\u044f \u0437\u0430\u0440\u0443\u0447\u0438\u043b\u0430\u0441\u044c \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u043e\u0439, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0430 \u041a\u0438\u0442\u0430\u044f \u0421\u0438 \u0426\u0437\u0438\u043d\u044c\u043f\u0438\u043d\u0430, \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u043c\u043e\u0439 \u0417\u0435\u0440\u043d\u043e\u0432\u043e\u0439 \u0431\u0438\u0440\u0436\u0438 \u0411\u0420\u0418\u041a\u0421, \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0439 \u043d\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0443 \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u043e\u0432 \u0442\u043e\u0440\u0433\u043e\u0432\u043b\u0438 \u0441\u0435\u043b\u044c\u0441\u043a\u043e\u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u043f\u0440\u043e\u0434\u0443\u043a\u0446\u0438\u0435\u0439. \u0412 2025 \u0433\u043e\u0434\u0443 \u0421\u0428\u0410 \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u0438\u043b\u0438 \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u044e \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u0443\u044e \u043f\u0440\u043e\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u043f\u043e\u043c\u043e\u0449\u044c, \u043e\u0441\u043b\u0430\u0431\u0438\u0432 \u0441\u0432\u043e\u044e \u0434\u0430\u0432\u043d\u044e\u044e \u0440\u043e\u043b\u044c \u0432 \u043e\u043a\u0430\u0437\u0430\u043d\u0438\u0438 \u0433\u0443\u043c\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u043e\u0439 \u043f\u043e\u043c\u043e\u0449\u0438. \u0421\u043e\u0432\u0441\u0435\u043c \u043d\u0435\u0434\u0430\u0432\u043d\u043e \u041a\u0438\u0442\u0430\u0439 \u043f\u043e\u0432\u044b\u0441\u0438\u043b \u043f\u0440\u043e\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c \u0432 \u0441\u0432\u043e\u0435\u043c 15-\u043c \u043f\u044f\u0442\u0438\u043b\u0435\u0442\u043d\u0435\u043c \u043f\u043b\u0430\u043d\u0435 (2026\u20132030 \u0433\u0433.), \u0441\u0434\u0435\u043b\u0430\u0432 \u0435\u0435 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u043e\u043c \u0441\u0432\u043e\u0435\u0433\u043e \u043f\u0440\u0435\u0434\u0441\u0435\u0434\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0432 \u0410\u0437\u0438\u0430\u0442\u0441\u043a\u043e-\u0422\u0438\u0445\u043e\u043e\u043a\u0435\u0430\u043d\u0441\u043a\u043e\u043c \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u0435 (\u0410\u0422\u042d\u0421) \u0432 2026 \u0433\u043e\u0434\u0443.","caption_entities":[{"offset":0,"length":99,"type":"bold"}]}},{"update_id":686890320,
