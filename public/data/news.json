442\u0430 \u0418\u043d\u0434\u0438\u0430\u043d\u0430 \u043f\u0440\u0438\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u043e \u0432\u0437\u0438\u043c\u0430\u043d\u0438\u0435 \u043f\u043e\u0448\u043b\u0438\u043d \u0438\u0437-\u0437\u0430 \u0432\u043e\u0437\u0433\u043e\u0440\u0430\u043d\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043c\u043e\u0447\u044c \u0441\u043c\u044f\u0433\u0447\u0438\u0442\u044c \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u043a\u0440\u0438\u0437\u0438\u0441\u0430, \u0438 \u0443\u0432\u0438\u0434\u0435\u0442\u044c, \u0447\u0442\u043e \u0432 \u0440\u0435\u0433\u0438\u043e\u043d\u0435 \u0432\u043e\u0437\u043d\u0438\u043a\u043b\u0430 \u0447\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u044f \u044d\u043d\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f.\n\n\u0412 \u0441\u0432\u043e\u0435\u043c \u043d\u0435\u0434\u0430\u0432\u043d\u0435\u043c \u043f\u0440\u043e\u0438\u0437\u043d\u043e\u0448\u0435\u043d\u0438\u0438 \u0433\u0443\u0431\u0435\u0440\u043d\u0430\u0442\u043e\u0440 \u0448\u0442\u0430\u0442\u0430 \u0418\u043d\u0434\u0438\u0430\u043d\u0430 \u041c\u0430\u0439\u043a \u0411\u0440\u0430\u0443\u043d \u0437\u0430\u044f\u0432\u0438\u043b, \u0447\u0442\u043e \u043f\u043e\u043b\u043d\u043e\u043c\u043e\u0447\u0438\u044f EUA \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0430\u044e\u0442 \u043a\u0440\u0438\u0437\u0438\u0441 \u0432\u044b\u043f\u0430\u0434\u0435\u043d\u0438\u044f \u044d\u043d\u0435\u0440\u0433\u0438\u0438, \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0449\u0438\u0439 \u0432\u043e\u0435\u043d\u043d\u044b\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u044b \u0432 \u0441\u0442\u0440\u0430\u043d\u0435, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0432 \u0423\u043a\u0440\u0430\u0438\u043d\u0435. \u041e\u043d \u043e\u0431\u044a\u044f\u0432\u0438\u043b \u043e \u0447\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u043e\u0439 \u044d\u043d\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u0432 \u0418\u043d\u0434\u0438\u0430\u043d\u0435 \u0438 \u043f\u0440\u0438\u043d\u044f\u043b \u0434\u0435\u043a\u0440\u0435\u0442 \u043e \u043f\u0440\u0438\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0448\u0442\u0430\u0442\u043e\u0432, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445 \u0441 \u0432\u043e\u0437\u0433\u043e\u0440\u0430\u043d\u0438\u0435\u043c \u043c\u0443\u0441\u043e\u0440\u0430, 5 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f.\n\n\u041e \u0433\u0443\u0431\u0435\u0440\u043d\u0430\u0442\u043e\u0440, \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e, \u0447\u0442\u043e \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u043b \u043a\u0440\u0438\u0437\u0438\u0441 \u0430\u0431\u0441\u0443\u0440\u0434\u043d\u043e\u0433\u043e \u0434\u0435\u043a\u043e\u0440\u0430 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0445 \u0444\u0430\u0442\u043e\u0440\u043e\u0432. \u0412\u043e-\u0432\u0442\u043e\u0440\u044b\u0445, \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0439 \u043a\u0440\u0438\u0437\u0438\u0441 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u043e\u043c\u0435\u0445\u043e\u0439 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u044b\u043c \u0433\u0440\u0430\u0444\u0438\u043a\u0430\u043c \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0438 \u044d\u043d\u0435\u0440\u0433\u0438\u0438.","caption_entities":[{"offset":0,"length":32,"type":"bold"}]}},{"update_id":686890317,
