430\u0437\u0438\u0440\u044b\u00bb \u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442 \u0431\u044b\u0432\u0448\u0435\u0433\u043e \u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430 \u043e\u0431\u043e\u0440\u043e\u043d\u044b \u0421\u0428\u0410, \u0441\u0442\u043e\u0438\u043b\u043e \u043b\u0438 \u0441\u0432\u0435\u0440\u0436\u0435\u043d\u0438\u0435 \u0421\u0430\u0434\u0434\u0430\u043c\u0430 \u0425\u0443\u0441\u0435\u0439\u043d\u0430 \u043c\u043d\u043e\u0433\u0438\u0445 \u0436\u0438\u0437\u043d\u0435\u0439, \u043f\u043e\u0433\u0438\u0431\u0448\u0438\u0445 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0438 \u043f\u043e\u0441\u043b\u0435 \u0432\u043e\u0439\u043d\u044b \u0432 \u0418\u0440\u0430\u043a\u0435 2003 \u0433\u043e\u0434\u0430. \u042d\u0442\u043e \u0438\u043d\u0442\u0435\u0440\u0432\u044c\u044e \u0431\u044b\u043b\u043e \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043e \u0432\n\n\u0414\u043e\u043d\u0430\u043b\u044c\u0434 \u0420\u0430\u043c\u0441\u0444\u0435\u043b\u0434, \u0440\u0430\u0431\u043e\u0442\u0430\u0432\u0448\u0438\u0439 \u0432 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u0411\u0443\u0448\u0430 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430, \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043e \u0441\u0432\u0435\u0440\u0436\u0435\u043d\u0438\u0435 \u0436\u0435\u0441\u0442\u043e\u043a\u043e\u0433\u043e \u0434\u0438\u043a\u0442\u0430\u0442\u043e\u0440\u0430, \u0443\u0431\u0438\u0432\u0448\u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u043d\u0430\u0440\u043e\u0434, \u043e\u043f\u0440\u0430\u0432\u0434\u044b\u0432\u0430\u0435\u0442 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430.\n\n\u041f\u043e \u0441\u043b\u043e\u0432\u0430\u043c \u0420\u0430\u043c\u0441\u0444\u0435\u043b\u0434\u0430, \u0411\u0430\u0448\u0430\u0440 \u0410\u0441\u0430\u0434 \u2014 \u0436\u0435\u0441\u0442\u043e\u043a\u0438\u0439 \u0434\u0438\u043a\u0442\u0430\u0442\u043e\u0440, \u0443\u0431\u0438\u0432\u0430\u044e\u0449\u0438\u0439 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u043d\u0430\u0440\u043e\u0434.\n\n\u0411\u043e\u043b\u0435\u0435 2 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u043e\u0432 \u0441\u043c\u0435\u0440\u0442\u0435\u0439 \u043f\u043e\u0441\u043b\u0435 \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044f \u0432 \u0418\u0440\u0430\u043a \u0432 2003 \u0433\u043e\u0434\u0443.","caption_entities":[{"offset":0,"length":126,"type":"bold"}]}},{"update_id":686890362,
