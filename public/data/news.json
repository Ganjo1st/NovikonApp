\u0435 \u043f\u043e\u0441\u0435\u0442\u0438\u043b \u0421\u0435\u0440\u0431\u0438\u044e. \u0415\u0433\u043e \u043f\u043e\u0435\u0437\u0434\u043a\u0430 \u0432 \u0411\u0435\u043b\u0433\u0440\u0430\u0434 \u0432\u044b\u0437\u0432\u0430\u043b\u0430 \u043d\u0435\u043c\u0430\u043b\u043e \u0441\u043f\u043e\u0440\u043e\u0432, \u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u043e\u043d \u043a\u0440\u0430\u0439\u043d\u0435 \u043d\u0435\u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0435\u043d \u0441\u0440\u0435\u0434\u0438 \u043f\u043e\u0434\u0430\u0432\u043b\u044f\u044e\u0449\u0435\u0433\u043e \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0430 \u0441\u0435\u0440\u0431\u043e\u0432. \u0411\u043e\u043b\u0435\u0435 \u0442\u043e\u0433\u043e, \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442 \u0420\u043e\u0441\u0441\u0438\u0438 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440 \u041f\u0443\u0442\u0438\u043d \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u0435\u043d \u0432 \u0421\u0435\u0440\u0431\u0438\u0438, \u0447\u0435\u043c \u043b\u044e\u0431\u043e\u0439 \u0434\u0440\u0443\u0433\u043e\u0439 \u043b\u0438\u0434\u0435\u0440, \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0439 \u0438\u043b\u0438 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0439, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0441\u0430\u043c\u043e\u0433\u043e \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u0430 \u0412\u0443\u0447\u0438\u0447\u0430, \u0438 \u044d\u0442\u043e\u0442 \u0444\u0430\u043a\u0442 \u043f\u0440\u0438\u0437\u043d\u0430\u044e\u0442 \u0434\u0430\u0436\u0435 \u043f\u0440\u043e\u0437\u0430\u043f\u0430\u0434\u043d\u044b\u0435 \u0421\u041c\u0418 \u0432 \u0441\u0442\u0440\u0430\u043d\u0435. \u0412\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u0432\u043e\u043f\u0440\u043e\u0441, \u043f\u043e\u0447\u0435\u043c\u0443 \u0417\u0435\u043b\u0435\u043d\u0441\u043a