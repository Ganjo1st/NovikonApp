25 \u0433\u043e\u0434\u0443, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u0441\u0442\u0438\u0447\u044c \u0446\u0435\u043b\u0438 \u0432 100 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432, \u0440\u0430\u0441\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u044f\u0441\u044c \u0432 \u043c\u0435\u0441\u0442\u043d\u043e\u0439 \u0432\u0430\u043b\u044e\u0442\u0435 \u043a 2030 \u0433\u043e\u0434\u0443. \u0423\u0441\u0438\u043b\u0438\u044f \u043f\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044e \u0444\u0438\u043d\u0438\u0448\u043d\u043e\u0439 \u0447\u0435\u0440\u0442\u044b \u043d\u0430\u0431\u0440\u0430\u043b\u0438 \u043e\u0431\u043e\u0440\u043e\u0442\u044b, \u043a\u043e\u0433\u0434\u0430 \u043e\u0431\u0435 \u0441\u0442\u0440\u0430\u043d\u044b \u043f\u0435\u0440\u0435\u0440\u0438\u0441\u043e\u0432\u0430\u043b\u0438 \u043b\u0438\u043d\u0438\u044e \u0432 \u0442\u043e\u0440\u0433\u043e\u0432\u043e\u0439 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0435. \u0420\u043e\u0441\u0441\u0438\u044f \u0442\u0430\u043a\u0436\u0435 \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u043d\u043e\u0432\u044b\u0435 \u0442\u043e\u0440\u0433\u043e\u0432\u044b\u0435 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u044b, \u0447\u0442\u043e\u0431\u044b \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u0442\u044c \u0418\u043d\u0434\u0438\u0438 \u0440\u0430\u0441\u0447\u0435\u0442\u044b \u043f\u043e \u0442\u0440\u0430\u043d\u0441\u0433\u0440\u0430\u043d\u0438\u0447\u043d\u044b\u043c \u0441\u0434\u0435\u043b\u043a\u0430\u043c \u0432 \u043c\u0435\u0441\u0442\u043d\u043e\u0439 \u0432\u0430\u043b\u044e\u0442\u0435. \u0412\u0441\u0435 \u044d\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0447\u0430\u0441\u0442\u044c\u044e \u0443\u0441\u0438\u043b\u0438\u0439 \u043f\u043e \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u044e \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u044b \u043f\u043e \u0434\u0435\u0434\u043e\u043b\u043b\u0430\u0440\u0438\u0437\u0430\u0446\u0438\u0438 \u0438 \u0443\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044e \u043c\u0435\u0441\u0442\u043d\u044b\u0445 \u0432\u0430\u043b\u044e\u0442 \u043d\u0430 \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u043c \u043a\u0440\u0430\u0435. \u0414\u0435\u0434\u043e\u043b\u043b\u0430\u0440\u0438\u0437\u0430\u0446\u0438\u044f \u0442\u0435\u043f\u0435\u0440\u044c \u0441\u0442\u0430\u043b\u0430 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e \u0432 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u0441\u0442\u0440\u0430\u043d\u0430\u0445, \u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043b\u043b\u0430\u0440\u0430 \u0421\u0428\u0410 \u043d\u0430 \u043a\u043e\u0440\u043e\u0442\u043a\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0441\u043d\u0438\u0436\u0430\u0435\u0442\u0441\u044f. \"\u0420\u043e\u0441\u0441\u0438\u044f \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u044f \u043f\u043b\u0430\u0442\u0435\u0436\u0435\u0439 \u0438 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 \u0432 \u043c\u0435\u0441\u0442\u043d\u044b\u0445 \u0432\u0430\u043b\u044e\u0442\u0430\u0445 \u0441\u043e \u0441\u0442\u0440\u0430\u043d\u0430\u043c\u0438-\u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0430\u043c\u0438, \u0442\u0430\u043a\u0438\u043c\u0438 \u043a\u0430\u043a \u0418\u043d\u0434\u0438\u044f. \u0427\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u043e \u0432\u0430\u0436\u043d\u043e \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u043c\u0435\u0441\u0442\u043d\u044b\u0445 \u0432\u0430\u04