38 \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u043d\u044b\u0445 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430\u0445 \u0438 \u200b\u200b\u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0449\u0438\u0439 \u043e\u0431\u0448\u0438\u0440\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0433\u0435\u043e\u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438 \u0438 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u044b\u0445 \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439.\n\n\u042d\u0441\u043a\u0430\u043b\u0430\u0446\u0438\u044f \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0432 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u0445 \u043c\u0435\u0436\u0434\u0443 \u0411\u0440\u0430\u0437\u0438\u043b\u0438\u0430 \u0438 \u0412\u0430\u0448\u0438\u043d\u0433\u0442\u043e\u043d\u043e\u043c \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u0440\u0430\u0441\u0442\u0443\u0449\u0443\u044e \u043e\u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0435\u043d\u043d\u043e\u0441\u0442\u044c. \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0443 \u0431\u0440\u0430\u0437\u0438\u043b\u044c\u0441\u043a\u043e\u0433\u043e \u0436\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u0430 \u0416\u043e\u0430\u0443 \u041f\u0430\u0443\u043b\u0443 \u0428\u0430\u0440\u043b\u043e, \u043f\u043e\u0434\u0445\u0432\u0430\u0447\u0435\u043d\u043d\u043e\u043c\u0443 \u0442\u0430\u043a\u0438\u043c\u0438 \u043a\u0440\u0443\u043f\u043d\u044b\u043c\u0438 \u0438\u0437\u0434\u0430\u043d\u0438\u044f\u043c\u0438, \u043a\u0430\u043a UOL, \u0414\u043e\u043d\u0430\u043b\u044c\u0434 \u0422\u0440\u0430\u043c\u043f \u00ab\u0433\u043e\u0442\u043e\u0432\u0438\u0442 \u043f\u043e\u0447\u0432\u0443\u00bb \u0434\u043b\u044f \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u00ab\u0437\u0430\u0445\u0432\u0430\u0442\u0430\u00bb \u043b\u0435\u0432\u043e\u0433\u043e \u043f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u0430 \u0411\u0440\u0430\u0437\u0438\u043b\u0438\u0438 \u041b\u0443\u0438\u0441\u0430 \u0418\u043d\u0430\u0441\u0438\u0443 \u0434\u0430 \u0421\u0438\u043b\u0432\u044b, \u0431\u043e\u043b\u0435\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e \u043a\u0430\u043a \u041b\u0443\u043b\u0430.\n\n\u0428\u0430\u0440\u043b\u043e \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043e \u0412\u0430\u0448\u0438\u043d\u0433\u0442\u043e\u043d \u0441\u043e\u0437\u0434\u0430\u0435\u0442 \u00ab\u0434\u0438\u0441\u043a\u0443\u0440\u0441\u0438\u0432\u043d\u0443\u044e \u0438 \u0432\u043e\u0435\u043d\u043d\u0443\u044e \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443\u00bb, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u044d\u0442\u043e\u0442 \u043a\u0440\u0430\u0439\u043d\u0438\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u043c. \u042d\u043a\u0441\u043f\u0435\u0440\u0442 \u043f\u043e\u0434\u0447\u0435\u0440\u043a\u0438\u0432\u0430\u0435\u0442, \u0447\u0442\u043e \u044d\u0442\u043e \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u0441\u043a\u043e\u0440\u0435\u0435 \u0433\u0435\u043e\u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u043e\u0439, \u0447\u0435\u043c \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u043e\u0439 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0435\u0439.","caption_entities":[{"offset":0,"length":57,"type":"bold"}]}}]}}
