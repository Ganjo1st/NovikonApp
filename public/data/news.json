7-\u0437\u0430 \u0432\u043e\u0439\u043d\u044b \u0432 \u0418\u0440\u0430\u043d\u0435, \u043a\u0430\u043a \u043e\u0436\u0438\u0434\u0430\u0435\u0442\u0441\u044f, \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u0442 \u043a \u0440\u043e\u0441\u0442\u0443 \u0438\u043d\u0444\u043b\u044f\u0446\u0438\u0438, \u0441\u0438\u0433\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u044f \u043e \u0432\u043e\u0437\u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0438 \u043a\u0440\u0438\u0437\u0438\u0441\u0430 \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u0438 \u0436\u0438\u0437\u043d\u0438 \u0432 \u0421\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u043d\u043e\u043c \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u0442\u0432\u0435. \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u044b \u0431\u044b\u043b\u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u044b \u043f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0438\u043e\u0434\u0430, \u043a\u043e\u0433\u0434\u0430 \u0438\u043d\u0444\u043b\u044f\u0446\u0438\u044f \u0438\u043c\u0435\u043b\u0430 \u0431\u043e\u043b\u0435\u0435 \u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u0443\u044e \u0442\u0435\u043d\u0434\u0435\u043d\u0446\u0438\u044e.\n\n\u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u0431\u043e\u043b\u0435\u0435 \u0447\u0435\u0442\u043a\u0443\u044e \u0442\u0435\u043d\u0434\u0435\u043d\u0446\u0438\u044e \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u044f \u0443\u0440\u043e\u0432\u043d\u044f \u0438\u043d\u0444\u043b\u044f\u0446\u0438\u0438 \u0432 \u043d\u0430\u0447\u0430\u043b\u0435 \u0433\u043e\u0434\u0430, \u0447\u0442\u043e \u0432\u0441\u0435\u043b\u044f\u0435\u0442 \u043d\u0430\u0434\u0435\u0436\u0434\u0443 \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u0446\u0435\u043b\u0435\u0432\u043e\u0439 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c \u0411\u0430\u043d\u043a\u0430 \u0410\u043d\u0433\u043b\u0438\u0438 \u0432 2% \u0432\u043f\u043e\u043b\u043d\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0438\u043c. \u042d\u0442\u0438 \u043d\u0430\u0434\u0435\u0436\u0434\u044b \u0442\u0435\u043f\u0435\u0440\u044c \u0438\u0441\u043f\u0430\u0440\u0438\u043b\u0438\u0441\u044c \u0438\u0437-\u0437\u0430 \u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0441\u043e\u043a\u0438\u0445 \u043e\u043f\u0442\u043e\u0432\u044b\u0445 \u0446\u0435\u043d \u043d\u0430 \u044d\u043d\u0435\u0440\u0433\u043e\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0430\u0447\u0430\u043b\u0438 \u043d\u0430\u043a\u0430\u043f\u043b\u0438\u0432\u0430\u0442\u044c\u0441\u044f \u043f\u043e\u0441\u043b\u0435 \u044d\u0441\u043a\u0430\u043b\u0430\u0446\u0438\u0438 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u043d\u0430 \u0411\u043b\u0438\u0436\u043d\u0435\u043c \u0412\u043e\u0441\u0442\u043e\u043a\u0435.","caption_entities":[{"offset":0,"length":101,"type":"bold"}]}},{"update_id":686890368,
