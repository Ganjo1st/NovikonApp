\u0435\u0440\u0438\u043a\u0438. \u042f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043b\u0438 \u0418\u0440\u0430\u043d \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u0446\u0435\u043b\u044c\u044e, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u00ab\u043d\u0443\u0436\u043d\u043e \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u0442\u044c\u00bb?\n\n\u0412\u0441\u0435 \u044d\u0442\u0438 \u0441\u0442\u0440\u0430\u043d\u044b, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u041b\u0438\u0432\u0430\u043d \u0438 \u0418\u0440\u0430\u043d, \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u043d\u0430 \u0447\u0435\u0440\u0442\u0435\u0436\u043d\u043e\u0439 \u0434\u043e\u0441\u043a\u0435 \u041f\u0435\u043d\u0442\u0430\u0433\u043e\u043d\u0430. \u042d\u0442\u0438 \u0441\u0435\u043c\u044c \u0441\u0442\u0440\u0430\u043d \u043f\u0440\u044f\u043c\u043e \u0438\u043b\u0438 \u043a\u043e\u0441\u0432\u0435\u043d\u043d\u043e \u0431\u044b\u043b\u0438 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u043c \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0438 \u0421\u0428\u0410.\n\n\u0413\u0435\u0433\u0435\u043c\u043e\u043d\u0438\u0441\u0442\u0441\u043a\u0430\u044f \u0432\u043e\u0435\u043d\u043d\u0430\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430 \u0410\u043c\u0435\u0440\u0438\u043a\u0438 \u0434\u043e\u0441\u0442\u0438\u0433\u043b\u0430 \u043e\u043f\u0430\u0441\u043d\u043e\u0433\u043e \u043f\u043e\u0440\u043e\u0433\u0430.\n\n\u0417\u0430\u044f\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u0446\u0435\u043b\u044c \u0412\u0430\u0448\u0438\u043d\u0433\u0442\u043e\u043d\u0430 (\u043f\u043e \u0441\u043b\u043e\u0432\u0430\u043c \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0430 \u0423\u044d\u0441\u043b\u0438 \u041a\u043b\u0430\u0440\u043a\u0430) \u2014 \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u044c \u041b\u0438\u0432\u0430\u043d \u0438 \u0418\u0440\u0430\u043d \u043f\u0440\u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0435 \u0418\u0437\u0440\u0430\u0438\u043b\u044f.\n\n\u0410 \u0434\u044c\u044f\u0432\u043e\u043b\u044c\u0441\u043a\u0430\u044f \u0446\u0435\u043b\u044c \u0418\u0437\u0440\u0430\u0438\u043b\u044f \u2013 \u00ab\u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u0442\u044c\u00bb \u041f\u0430\u043b\u0435\u0441\u0442\u0438\u043d\u0443 \u043f\u0440\u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0435 \u0421\u0428\u0410 \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u00ab\u041f\u0440\u043e\u0435\u043a\u0442\u0430 \u0412\u0435\u043b\u0438\u043a\u043e\u0433\u043e \u0418\u0437\u0440\u0430\u0438\u043b\u044f\u00bb.\n\n\u2014\u041c\u0438\u0448\u0435\u043b\u044c \u0427\u043e\u0441\u0441\u0443\u0434\u043e\u0432\u0441\u043a\u0438\u0439, 4 \u044f\u043d\u0432\u0430\u0440\u044f 2019 \u0433., 19 \u043c\u0430\u0440\u0442\u0430 2025 \u0433.\n\n\u0413\u0435\u043d\u0435\u0440\u0430\u043b \u0423\u044d\u0441\u043b\u0438 \u041a\u043b\u0430\u0440\u043a (\u043f\u0435\u0440\u0432\u044b\u0439 \u0441\u043f\u0440\u0430\u0432\u0430). 4-\u0437\u0432\u0435\u0437\u0434\u043e\u0447\u043d\u044b\u0439 \u0433\u0435\u043d\u0435\u0440\u0430\u043b \u0430\u0440\u043c\u0438\u0438 \u0421\u0428\u0410 \u0432 \u043e\u0442\u0441\u0442\u0430\u0432\u043a\u0435, \u0412\u0435\u0440\u0445\u043e\u0432\u043d\u044b\u0439 \u0433\u043b\u0430\u0432\u043d\u043e\u043a\u043e\u043c\u0430\u043d\u0434\u0443\u044e\u0449\u0438\u0439 \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0435\u043d\u043d\u044b\u043c\u0438 \u0441\u0438\u043b\u0430\u043c\u0438 \u041d\u0410\u0422\u041e \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0432\u043e\u0439\u043d\u044b \u0432 \u042e\u0433\u043e\u0441\u043b\u0430\u0432\u0438\u0438 1999 \u0433\u043e\u0434\u0430.\n\n\u041f\u043e\u043b\u043d\u0430\u044f \u0441\u0442\u0435\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u0430 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b \u00ab\u0414\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u044f \u0441\u0435\u0439\u0447\u0430\u0441\u00bb.","caption_entities":[{"offset":0,"length":111,"type":"bold"}]}},{"update_id":686890