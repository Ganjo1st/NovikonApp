\u0430\u043a \u0418\u043d\u0434\u0438\u044f, \u043f\u043e\u044f\u0441\u043d\u0438\u043b\u0430 \u0442\u043e\u0440\u0433\u043e\u0432\u044b\u0439 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u044c \u041c\u043e\u0441\u043a\u0432\u044b \u0432 \u0418\u043d\u0434\u0438\u0438 \u0417\u043b\u0430\u0442\u0430 \u0410\u043d\u0442\u0443\u0448\u0435\u0432\u0430. \"\u041a\u0440\u0430\u0439\u043d\u0435 \u0432\u0430\u0436\u043d\u043e \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u043c\u0435\u0441\u0442\u043d\u044b\u0445 \u0432\u0430\u043b\u044e\u0442\", - \u043e\u0442\u043c\u0435\u0442\u0438\u043b\u0430 \u043e\u043d\u0430, \u0443\u043a\u0430\u0437\u0430\u0432, \u0447\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u043f\u043b\u0430\u0442\u0435\u0436\u0435\u0439 \u043c\u0435\u0436\u0434\u0443 \u0420\u043e\u0441\u0441\u0438\u0435\u0439 \u0438 \u0418\u043d\u0434\u0438\u0435\u0439 \u0441\u0435\u0439\u0447\u0430\u0441 \"\u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432 \u043c\u0435\u0441\u0442\u043d\u044b\u0445 \u0432\u0430\u043b\u044e\u0442\u0430\u0445\". \u0410\u043d\u0442\u0443\u0448\u0435\u0432\u0430 \u0441\u043e\u043e\u0431\u0449\u0438\u043b\u0430, \u0447\u0442\u043e \u0442\u0440\u0438 \u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u0438\u0445 \u0431\u0430\u043d\u043a\u0430 - \u0421\u0431\u0435\u0440\u0431\u0430\u043d\u043a, \u0413\u0430\u0437\u043f\u0440\u043e\u043c \u0411\u0430\u043d\u043a \u0438 \u0411\u0430\u043d\u043a \u0412\u0422\u0411 - \u0438\u043c\u0435\u044e\u0442 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0432 \u0418\u043d\u0434\u0438\u0438. \"\u0410\u043b\u044c\u0444\u0430-\u0411\u0430\u043d\u043a\", \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u0439 \u0447\u0430\u0441\u0442\u043d\u044b\u0439 \u0431\u0430\u043d\u043a \u0432 \u0420\u043e\u0441\u0441\u0438\u0438, \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u0441\u043a\u043e\u0440\u043e \u043e\u0442\u043a\u0440\u043e\u0435\u0442 \u0441\u0432\u043e\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0432 \u0441\u0442\u0440\u0430\u043d\u0435. \u0420\u043e\u0441\u0441\u0438\u044f \u0438 \u041a\u0438\u0442\u0430\u0439 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u043b\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0437\u0430\u043f\u0430\u0434\u043d\u044b\u0445 \u0432\u0430\u043b\u044e\u0442 \u0432 \u0434\u0432\u0443\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0435\u0439 \u0442\u043e\u0440\u0433\u043e\u0432\u043b\u0435. \"\u041d\u0430\u0448\u0430 \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u0446\u0435\u043b\u044c - \u0434\u0435\u0434\u043e\u043b\u043b\u0430\u0440\u0438\u0437\u0430\u0446\u0438\u044f \u0438 \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u0438\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u043d\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0432\u0430\u043b\u044e\u0442, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e (\u043d\u0430) \u0434\u0432\u0443\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0435\u043c \u0443\u0440\u043e\u0432\u043d\u0435, \u043d\u043e \u0438 \u043d\u0430 \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435, \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 \u0411\u0420\u0418\u041a\u0421\", - \u0437\u0430\u044f\u0432\u0438\u043b\u0430 \u043e\u043d\u0430.","caption_entities":[{"offset":0,"length":75,"type":"bold"}]}},{"update_id":686890319,
