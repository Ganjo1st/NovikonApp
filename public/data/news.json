0432\u0443\u044e \u043f\u0440\u0438\u0432\u0438\u0432\u043a\u0443 \u043e\u0442 \u0433\u0440\u0438\u043f\u043f\u0430 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u043c\u0420\u041d\u041a Moderna (mFlusiva), \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u0443\u044e \u0434\u043b\u044f \u043f\u043e\u0436\u0438\u043b\u044b\u0445 \u043b\u044e\u0434\u0435\u0439 (\u0441\u0442\u0430\u0440\u0448\u0435 50 \u043b\u0435\u0442).\n\n\u0418\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u043e \u043f\u043e\u0436\u0438\u043b\u043e\u0435 \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0438\u0435 \u043f\u043e\u0441\u0442\u0440\u0430\u0434\u0430\u043b\u043e \u043e\u0442 Covid-19 \u0431\u043e\u043b\u044c\u0448\u0435, \u0447\u0435\u043c \u043b\u044e\u0431\u043e\u0439 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u0435\u0433\u043c\u0435\u043d\u0442 \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0438\u044f: \u0432 2020 \u0433\u043e\u0434\u0443 81% \u0441\u043c\u0435\u0440\u0442\u0435\u0439 \u0431\u044b\u043b\u0438 \u0441\u0442\u0430\u0440\u0448\u0435 65 \u043b\u0435\u0442, \u0432 2022 \u0433\u043e\u0434\u0443 92% \u0441\u043c\u0435\u0440\u0442\u0435\u0439 \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c \u043d\u0430 \u043f\u043e\u0436\u0438\u043b\u044b\u0445 \u043b\u044e\u0434\u0435\u0439, \u0430 \u0432 \u043f\u0435\u0440\u0438\u043e\u0434 \u0441 2022 \u043f\u043e 2024 \u0433\u043e\u0434 81,3% \u0441\u043c\u0435\u0440\u0442\u0435\u0439 \u0431\u044b\u043b\u0438 \u0441\u0440\u0435\u0434\u0438 \u043f\u043e\u0436\u0438\u043b\u044b\u0445 \u043b\u044e\u0434\u0435\u0439.\n\n\u0420\u0430\u043d\u0435\u0435 \u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u0438\u044f \u0432\u044b\u0441\u043e\u043a\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0439 \u0447\u0438\u043d\u043e\u0432\u043d\u0438\u043a FDA \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043b \u0437\u0430\u044f\u0432\u043a\u0443 Moderna \u0438\u0437-\u0437\u0430 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u043e\u0439 \u043e\u0441\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430 \u041a\u0435\u043d\u043d\u0435\u0434\u0438 \u043e \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0432\u0430\u043a\u0446\u0438\u043d, \u043f\u043e\u043a\u0430 \u043d\u0435 \u0432\u043c\u0435\u0448\u0430\u043b\u0430\u0441\u044c \u00ab\u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u0430\u044f\u00bb \u0433\u0440\u0443\u043f\u043f\u0430 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u043d\u0442\u043e\u0432, \u0447\u0442\u043e\u0431\u044b \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u0442\u044c \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u0438\u0435 FDA.","caption_entities":[{"offset":0,"length":55,"type":"bold"}]}},{"update_id":686890322,
