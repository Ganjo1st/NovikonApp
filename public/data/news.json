u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c. \u0420\u0430\u0437\u043b\u0438\u0447\u0438\u044f \u043c\u0435\u0436\u0434\u0443 \u0421\u0428\u0410 \u0438 \u0415\u0432\u0440\u043e\u043f\u043e\u0439 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435\u043b\u044c\u0437\u044f \u0438\u0433\u043d\u043e\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c, \u0438 \u043e\u043d\u0438 \u0441\u0442\u0430\u043b\u0438 \u043e\u0431\u0449\u0435\u0439 \u0442\u0435\u043c\u043e\u0439 \u0432 \u0441\u0430\u043c\u0438\u0445 \u0437\u0430\u043f\u0430\u0434\u043d\u044b\u0445 \u0421\u041c\u0418. \u041f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442 \u0421\u0428\u0410 \u0414\u043e\u043d\u0430\u043b\u044c\u0434 \u0422\u0440\u0430\u043c\u043f \u043d\u0435\u0434\u043e\u0432\u043e\u043b\u0435\u043d \u043f\u043e\u0437\u0438\u0446\u0438\u0435\u0439 \u0441\u0432\u043e\u0438\u0445 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0438\u0445 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u043e\u0432 \u0438 \u0442\u0435\u043f\u0435\u0440\u044c, \u043f\u043e\u0445\u043e\u0436\u0435, \u0433\u043e\u0442\u043e\u0432 \u0434\u0430\u0436\u0435 \u00ab\u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c\u00bb \u0438\u0445, \u0447\u0442\u043e\u0431\u044b \u043e\u0446\u0435\u043d\u0438\u0442\u044c \u0438\u0445 \u00ab\u043b\u043e\u044f\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u00bb.\n\n\u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043d\u0435\u0434\u0430\u0432\u043d\u0435\u0439 \u0441\u0442\u0430\u0442\u044c\u0435, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u043e\u0439 Bloomberg, \u0422\u0440\u0430\u043c\u043f \u043c\u0435\u043d\u044f\u0435\u0442 \u0441\u0432\u043e\u044e \u043f\u043e\u0437\u0438\u0446\u0438\u044e \u0432 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438 \u0432\u043e\u0435\u043d\u043d\u043e\u0439 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438 \u0421\u0428\u0410 \u0441\u0442\u0440\u0430\u043d-\u0447\u043b\u0435\u043d\u043e\u0432 \u041d\u0410\u0422\u041e. \u0412\u043c\u0435\u0441\u0442\u043e \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438 \u0422\u0440\u0430\u043c\u043f \u0442\u0435\u043f\u0435\u0440\u044c \u0445\u043e\u0447\u0435\u0442 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c, \u0432 \u043a\u0430\u043a\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u043a\u0430\u0436\u0434\u0430\u044f \u0441\u0442\u0440\u0430\u043d\u0430 \u041d\u0410\u0422\u041e \u0433\u043e\u0442\u043e\u0432\u0430 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0430\u0442\u044c \u0441 \u0421\u0428\u0410 \u0432 \u0432\u043e\u0435\u043d\u043d\u043e\u043c \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438. \u0426\u0435\u043b\u044c \u2014 \u043e\u0446\u0435\u043d\u0438\u0442\u044c \u043b\u043e\u044f\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0447\u043b\u0435\u043d\u0430 \u0430\u043b\u044c\u044f\u043d\u0441\u0430, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0432\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0432 \u0438\u0445 \u0437\u0430\u0449\u0438\u0442\u0443.","caption_entities":[{"offset":0,"length":44,"type":"bold"}]}}]}}
