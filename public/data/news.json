442\u0430\u043a \u0438 \u043d\u0435 \u043d\u0430\u0448\u043b\u0438. \u0415\u0435 \u043d\u0435\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u043c\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u043f\u0440\u0435\u0434\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0431\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043e\u043f\u0438\u0441\u0430\u043d\u044b \u0432 \u0441\u0442\u0430\u0442\u044c\u0435 \u043d\u0438\u0436\u0435 \u043e\u0442 10 \u0438\u044e\u043d\u044f 2006 \u0433\u043e\u0434\u0430.\n\n\u041e\u0433\u043b\u044f\u0434\u044b\u0432\u0430\u044f\u0441\u044c \u043d\u0430\u0437\u0430\u0434 \u043d\u0430 \u043a\u0440\u043e\u0432\u0430\u0432\u0443\u044e \u0431\u043e\u0439\u043d\u044e, \u0443\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u0443\u044e \u0432 \u0418\u0440\u0430\u043a\u0435 \u2013 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e\u0449\u0443\u044e\u0441\u044f \u2013 \u0438 \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u043d\u0430 \u0421\u0438\u0440\u0438\u044e, \u0433\u0434\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043f\u043e\u0434 \u0443\u0433\u0440\u043e\u0437\u043e\u0439 \u0432\u0435\u0441\u044c \u0440\u0435\u0433\u0438\u043e\u043d, \u0435\u0435 \u0441\u0443\u0434\u044c\u0431\u0430, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043e\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u0441\u0443\u0434\u044c\u0431\u0443 \u0441\u043e\u0442\u0435\u043d \u0442\u044b\u0441\u044f\u0447 \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u0437\u0430\u043c\u0443\u0447\u0435\u043d\u043d\u044b\u0445 \u0434\u043e\u043c\u0430, \u043d\u0430 \u0443\u043b\u0438\u0446\u0435, \u043d\u0430 \u0440\u044b\u043d\u043a\u0435, \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0435 \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u043b\u0436\u0438, \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0439 \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c \u0422\u043e\u043d\u0438 \u0411\u043b\u044d\u0440\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0434\u0430\u043b\u0430 \u0414\u0436\u043e\u0440\u0434\u0436\u0443 \u0411\u0443\u0448\u0443 \u043e\u043f\u0440\u0430\u0432\u0434\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u043d\u0435\u0437\u0430\u043a\u043e\u043d\u043d\u043e\u0433\u043e \u0432\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044f \u0432 \u0418\u0440\u0430\u043a.\n\n\u0412 \u043e\u0434\u043d\u043e\u0447\u0430\u0441\u044c\u0435 \u0432\u0441\u044f \u043d\u0430\u0446\u0438\u044f \u0441\u0442\u0430\u043b\u0430 \u0437\u0430\u043b\u043e\u0436\u043d\u0438\u0446\u0435\u0439 \u0421\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u043d\u044b\u0445 \u0428\u0442\u0430\u0442\u043e\u0432 \u0438 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u043f\u043e\u043c\u043e\u0449\u0438 \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u043c\u0430\u0440\u0438\u043e\u043d\u0435\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0421\u0428\u0410, \u0430 \u0438\u0445 \u043f\u043b\u0435\u043d\u043d\u0438\u043a\u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e\u0442 \u0443\u043c\u0438\u0440\u0430\u0442\u044c \u043d\u0435\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u043c\u044b\u043c\u0438 \u0441\u043f\u043e\u0441\u043e\u0431\u0430\u043c\u0438.","caption_entities":[{"offset":0,"length":121,"type":"bold"}]}},{"update_id":686890364,
